# Exact third-party downloads used by the build (checked in CI, release.yml).
# An empty checksum: the build prints the current one as a warning — copy it here.
# Changed upstream file: the build stops; check the new version, then update the line.
LLAMA_TAG=b12211
LLAMA_VULKAN_SHA256=
LLAMA_CPU_SHA256=
# PaddleOCR runtime: ocr-rs downloads this MNN build from the mutable "dev" release.
MNN_ASSET=mnn-dev-windows-x86_64.zip
MNN_SHA256=
